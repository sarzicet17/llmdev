   "source": [
    "YEAR_RANGE = 10\n",
    "\n",
    "principal = int(input(\"元金を入力してください: \"))\n",
    "annual_rate = float(input(\"年利を入力してください: \"))\n",
    "\n",
    "amount = principal\n",
    "for year in range(1, YEAR_RANGE + 1):\n",
    "    amount += amount * annual_rate / 100\n",
    "    \n",
    "print(f\"{YEAR_RANGE}年後の金額: {amount:.2f}\")"
   ]
